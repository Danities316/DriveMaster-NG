{
  "name": "@drivemaster/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cd ../.. && npm run build --workspace=shared",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prebuild": "cd ../.. && npm run build --workspace=shared",
    "build": "tsc -p tsconfig.json",
    "prestart": "cd ../.. && npm run build --workspace=shared",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "platform-admin:create": "tsx --env-file-if-exists=.env prisma/createPlatformAdmin.ts"
  },
  "dependencies": {
    "@drivemaster/shared": "*",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
