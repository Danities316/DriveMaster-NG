# Copy this file to .env and fill in real values for your machine.
# Never commit the real .env file.

# PostgreSQL connection string.
DATABASE_URL="postgresql://drivemaster:drivemaster@localhost:5432/drivemaster_dev?schema=public"

# Port the API server listens on.
PORT=4000

# development | test | production
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the web app's origin(s)).
WEB_ORIGIN="http://localhost:5173"

# Secret used to sign session tokens (Unit 2). Must be at least 32
# characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER reuse this placeholder value outside local development.
AUTH_TOKEN_SECRET="dev-only-placeholder-secret-change-me-before-deploying-32plus-chars"

# How long a login session stays valid, in seconds. Defaults to 30 days
# (2592000) if omitted — see the Unit 2 report for why that default was
# chosen for an offline-first app with unreliable connectivity.
AUTH_TOKEN_EXPIRES_IN_SECONDS=2592000
